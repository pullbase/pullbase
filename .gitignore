web/node_modules
web/dist
public/pullbase-website/node_modules
public/pullbase-website/.astro

# Embedded UI files (generated during build)
server/pkg/server/ui/

# Secrets directory
server/secrets/*
!server/secrets/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Docker compose for local dev
docker-compose.yml
docker-compose.override.yml