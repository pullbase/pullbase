# Pullbase Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# Database
POSTGRES_PASSWORD=change-this-to-a-secure-password

# Security - Generate with: openssl rand -hex 32
PULLBASE_JWT_SECRET=generate-a-secure-random-string
PULLBASE_WEBHOOK_SECRET_KEY=generate-another-secure-string

# GitHub App (optional - for private repository access)
# PULLBASE_GITHUB_APP_ID=your-app-id
